{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*zshrc*": "deny",
      "~/.zshrc*": "deny"
    },
    "bash": {
      "*": "allow",
      "*zshrc*": "deny"
    }
  }
}
